<Window x:Class="PenTastic.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenTastic" Width="1000" Height="660" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Grid Margin="32,22,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22">
            <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" VerticalAlignment="Center" Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text}" FontSize="13" Text="{Binding Headline}" />
                </StackPanel>
            </Border>
            <Image x:Name="Logo" Width="46" Height="46" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Title}" FontSize="24" Text="PenTastic" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource Dim}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="PHONE" />
                        <TextBlock Style="{StaticResource Title}" FontSize="22" Text="{Binding Headline}" />
                        <TextBlock Style="{StaticResource Dim}" FontSize="14" Margin="0,4,0,16" Text="{Binding Detail}" />
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Dim}" FontSize="12" Text="{Binding Usb}" />
                            </Border>
                            <Border Style="{StaticResource Pill}">
                                <TextBlock FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Dim}">
                                            <Setter Property="Text" Value="Bluetooth: off" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Bluetooth}" Value="True">
                                                    <Setter Property="Text" Value="Bluetooth: ready" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="DISPLAY" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,12"
                                   Text="The pen draws on this display, and the phone shows it." />
                        <WrapPanel>
                            <Border Style="{StaticResource Segment}" Margin="0,0,8,8">
                                <WrapPanel x:Name="DisplayList" />
                            </Border>
                            <Button Style="{StaticResource Button}" Content="Identify" Click="IdentifyDisplays" Margin="0,0,0,8"
                                    ToolTip="Show each display's number on it" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Dim}" FontSize="13" Margin="0,8,0,0" Text="{Binding MirrorLine}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="CANVAS" />
                        <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,16"
                                   Text="Switch the phone to Draw mode to sketch on PenTastic's own canvas, then copy or save the drawing." />
                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="Open canvas" Click="OpenCanvas" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button}" Content="Test the pen" Click="TestPen" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button}" Content="Open log" Click="OpenLog" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="PAIR A PHONE" />
                        <Border x:Name="QrArea" Visibility="Collapsed" Background="White" CornerRadius="10" Padding="10"
                                HorizontalAlignment="Center" Margin="0,2,0,14">
                            <Image x:Name="Qr" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock x:Name="PairText" Style="{StaticResource Dim}" Margin="0,0,0,16"
                                   Text="Needed once for Wi-Fi and Bluetooth. USB works without pairing." />
                        <Button x:Name="PairButton" Style="{StaticResource PrimaryButton}" Content="Show pairing code"
                                Click="TogglePairing" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Overline}" Text="SETTINGS" />
                        <CheckBox x:Name="StartWithWindows" Style="{StaticResource ToggleSwitch}" Content="Start with Windows"
                                  Margin="0,0,0,12" Click="StartWithWindowsClick" />
                        <CheckBox x:Name="MinimizeToTray" Style="{StaticResource ToggleSwitch}" Content="Minimize to tray"
                                  Margin="0,0,0,16" Click="MinimizeToTrayClick"
                                  ToolTip="Minimizing the dashboard or the canvas hides it in the tray instead of the taskbar." />
                        <Button Style="{StaticResource Button}" Content="Allow through Windows Firewall" Click="Firewall"
                                HorizontalAlignment="Left" ToolTip="Needed for Wi-Fi. Windows will ask for permission." />
                        <TextBlock x:Name="Version" Style="{StaticResource Dim}" FontSize="12" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
