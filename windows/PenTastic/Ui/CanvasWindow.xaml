<Window x:Class="PenTastic.CanvasWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PenTastic canvas" Width="1280" Height="820" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}">
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="D0" Modifiers="Control" Command="NavigationCommands.Zoom" />
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New" />
        <KeyBinding Key="PageUp" Command="NavigationCommands.PreviousPage" />
        <KeyBinding Key="PageDown" Command="NavigationCommands.NextPage" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save" />
        <CommandBinding Command="NavigationCommands.Zoom" Executed="Fit" />
        <CommandBinding Command="ApplicationCommands.New" Executed="AddPage" />
        <CommandBinding Command="NavigationCommands.PreviousPage" Executed="GoPrev" />
        <CommandBinding Command="NavigationCommands.NextPage" Executed="GoNext" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="Bar" Margin="18,12,18,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Heading}" Text="Canvas" VerticalAlignment="Center" Margin="0,0,22,0" />
                <TextBlock Style="{StaticResource Dim}" Text="Paper" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border Style="{StaticResource Segment}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="PaperWhite" Style="{StaticResource SegmentItem}" Content="White" GroupName="Paper" Checked="PaperChecked" />
                        <RadioButton x:Name="PaperBlack" Style="{StaticResource SegmentItem}" Content="Black" GroupName="Paper" Checked="PaperChecked" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Dim}" Text="Page" VerticalAlignment="Center" Margin="22,0,6,0" />
                <Button x:Name="PrevPage" Style="{StaticResource IconButton}" Click="GoPrev" ToolTip="Previous page (Page Up)"
                        AutomationProperties.Name="Previous page (Page Up)" Margin="0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M15.41,7.41L14,6l-6,6 6,6 1.41,-1.41L10.83,12z" />
                </Button>
                <TextBlock x:Name="PageText" Style="{StaticResource Text}" FontSize="13" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="NextPage" Style="{StaticResource IconButton}" Click="GoNext" ToolTip="Next page (Page Down)"
                        AutomationProperties.Name="Next page (Page Down)" Margin="0,0,4,0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M10,6L8.59,7.41 13.17,12l-4.58,4.59L10,18l6,-6z" />
                </Button>
                <Button x:Name="NewPage" Style="{StaticResource IconButton}" Click="AddPage" ToolTip="New page (Ctrl+N)"
                        AutomationProperties.Name="New page (Ctrl+N)" Margin="0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                </Button>
                <Button x:Name="RemovePage" Style="{StaticResource IconButton}" Click="DeletePage" ToolTip="Delete page"
                        AutomationProperties.Name="Delete page" Margin="0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2,-0.9 2,-2V7H6v12zM19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z" />
                </Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="−" Click="ZoomOut" ToolTip="Zoom out (Ctrl+wheel)" />
                <TextBlock x:Name="ZoomText" Style="{StaticResource Text}" FontSize="13" Width="54" TextAlignment="Center" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButton}" Content="+" Click="ZoomIn" ToolTip="Zoom in (Ctrl+wheel)" Margin="0,0,6,0" />
                <Button Style="{StaticResource Button}" Content="Fit" Click="Fit" ToolTip="Fit to window (Ctrl+0)" Margin="0,0,8,0" />
                <Button Style="{StaticResource IconButton}" Click="ToggleFullScreen" ToolTip="Full screen (F11)"
                        AutomationProperties.Name="Full screen" Margin="0,0,18,0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M7,14H5v5h5v-2H7v-3zM5,10h2V7h3V5H5v5zM17,17h-3v2h5v-5h-2v3zM14,5v2h3v3h2V5h-5z" />
                </Button>
                <Button Style="{StaticResource Button}" Content="Copy" Click="Copy" ToolTip="Copy the drawing (Ctrl+C), then paste it into any app" Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}" Content="Save PNG…" Click="Save" ToolTip="Save the drawing (Ctrl+S)" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource BackdropBrush}">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Wheel" SizeChanged="ScrollerResized" Focusable="False">
                <Grid x:Name="Page" Margin="36" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="Zoom" />
                    </Grid.LayoutTransform>
                    <Border x:Name="Sheet">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="3" Opacity="0.28" />
                        </Border.Effect>
                    </Border>
                    <Grid ClipToBounds="True">
                        <InkPresenter x:Name="Ink" IsHitTestVisible="False" />
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="PenRing" Width="14" Height="14" StrokeThickness="1.5" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Button x:Name="ExitFull" Grid.Row="1" Style="{StaticResource IconButton}" Click="ToggleFullScreen" ToolTip="Exit full screen (Esc)"
                AutomationProperties.Name="Exit full screen" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Opacity="0.9" Visibility="Collapsed">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M5,16h3v3h2v-5H5v2zM8,8H5v2h5V5H8v3zM14,19h2v-3h3v-2h-5v5zM16,8V5h-2v5h5V8h-3z" />
        </Button>

        <TextBlock x:Name="Footer" Grid.Row="2" Style="{StaticResource Dim}" FontSize="12" Margin="18,8,18,10" />
    </Grid>
</Window>
